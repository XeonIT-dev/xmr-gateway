# ==============================================================================
# xmr-gateway Docker / Podman Compose Environment Template
# ==============================================================================
# Copy to deploy/docker/.env.docker, set chmod 600, and replace all placeholders!
# Ensure host DATA_HOST_DIR and WALLET_HOST_DIR are owned by UID/GID 10001 (0700).
# ==============================================================================

GATEWAY_HOST_PORT=8080
XMR_GATEWAY_DOMAIN=pay.example.com
# Keep DATA_HOST_DIR and WALLET_HOST_DIR as non-overlapping sibling directories (SELinux :Z & isolation)
DATA_HOST_DIR=../../data/gateway
WALLET_HOST_DIR=../../data/wallet

# Required >= 32-byte distinct secrets (generate with: openssl rand -hex 32)
API_SECRET_KEY=replace-with-at-least-32-bytes-of-high-entropy-random-hex
OPERATOR_API_KEY=replace-with-distinct-at-least-32-bytes-operator-secret
WEBHOOK_SECRET=replace-with-at-least-32-bytes-of-webhook-hmac-secret

# Outbound webhook SSRF policy (keep false / true in production)
DEFAULT_WEBHOOK_URL=
ALLOW_PRIVATE_WEBHOOKS=false
REQUIRE_HTTPS_WEBHOOKS=true

# Monero Network & Custody Mode
MONERO_NETWORK=mainnet
WALLET_MODE=view_only
ENABLE_AUTO_SWEEP=false
ALLOW_HOT_WALLET_WITHOUT_SWEEP=false
COLD_WALLET_ADDRESS=

# Wallet RPC Credentials (Digest auth strictly enforced even on internal bridge)
MONERO_RPC_USER=xmr_gateway_user
MONERO_RPC_PASS=replace-with-secure-rpc-password
ALLOW_UNAUTHENTICATED_RPC=false
# Required ONLY because monero-wallet-rpc runs as a separate container on xmr_internal:
ALLOW_INSECURE_REMOTE_RPC=true

# Remote Monero Daemon (used by monero-wallet-rpc).
# Leave empty to auto-select per MONERO_NETWORK:
#   mainnet  -> xmr-node.cakewallet.com:18081
#   stagenet -> node.monerodevs.org:38089
#   testnet  -> testnet.xmr-tw.org:28081
MONERO_REMOTE_NODE=
# Initial blockchain height when creating a new wallet (leave empty for network-aware default:
# mainnet=3280000, stagenet=1600000, testnet=2600000)
WALLET_RESTORE_HEIGHT=
MONERO_TRUSTED_DAEMON=false
MONERO_RPC_PROXY=

# Optional explicit monerod JSON-RPC URL for allow_resweep sync verification (AUDIT-001)
# MONERO_DAEMON_RPC_URL=https://your-monerod.example:18081/json_rpc
# MONERO_DAEMON_RPC_USER=
# MONERO_DAEMON_RPC_PASS=

# Confirmations, Finality & Observability
REQUIRED_CONFIRMATIONS=10
SETTLEMENT_CONFIRMATIONS=15
SWEEP_PRIORITY=0
SUBADDRESS_MONITOR_DAYS=0
INVOICE_TTL_SECONDS=3600
SCAN_INTERVAL_SECONDS=10
WEBHOOK_POLL_INTERVAL_SECONDS=5
RUST_LOG=info,xmr_gateway=debug
LOG_FORMAT=json
