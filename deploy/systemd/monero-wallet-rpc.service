[Unit]
Description=Monero Wallet JSON-RPC Daemon for xmr-gateway
Documentation=https://github.com/XeonIT-dev/xmr-gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xmr-gateway
Group=xmr-gateway
WorkingDirectory=/var/lib/xmr-gateway
EnvironmentFile=/etc/xmr-gateway/.env
RuntimeDirectory=xmr-gateway
RuntimeDirectoryMode=0700
UMask=0077

# Render RPC credentials and daemon options into a RAM-only 0600 config file so
# MONERO_RPC_PASS never appears in `ps aux` / `/proc/<pid>/cmdline`.
# Delegated to a standalone POSIX script so systemd never expands `${...}` or `%`.
ExecStartPre=/usr/share/xmr-gateway/scripts/render-wallet-rpc-conf.sh /run/xmr-gateway/wallet-rpc.conf

ExecStart=/usr/local/bin/monero-wallet-rpc \
  --non-interactive \
  --no-initial-sync \
  --wallet-file /var/lib/xmr-gateway/wallet/gateway_wallet \
  --password-file /var/lib/xmr-gateway/wallet/gateway_wallet.password \
  --rpc-bind-ip 127.0.0.1 \
  --rpc-bind-port 18082 \
  --config-file /run/xmr-gateway/wallet-rpc.conf \
  --log-file /var/lib/xmr-gateway/monero-wallet-rpc.log \
  --log-level 1

KillSignal=SIGTERM
TimeoutStopSec=30
Restart=on-failure
RestartSec=5

# Systemd Sandboxing & Least-Privilege Hardening (XMR-037)
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
ReadWritePaths=/var/lib/xmr-gateway /run/xmr-gateway

[Install]
WantedBy=multi-user.target
