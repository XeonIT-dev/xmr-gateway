#!/bin/sh
set -eu

#DEBHELPER#

case "${1:-}" in
    configure)
        if ! getent group xmr-gateway >/dev/null 2>&1; then
            addgroup --system xmr-gateway >/dev/null 2>&1 || groupadd --system xmr-gateway
        fi
        if ! getent passwd xmr-gateway >/dev/null 2>&1; then
            adduser --system --ingroup xmr-gateway --home /var/lib/xmr-gateway \
                --no-create-home --shell /usr/sbin/nologin xmr-gateway >/dev/null 2>&1 \
                || useradd --system --gid xmr-gateway --home-dir /var/lib/xmr-gateway \
                    --no-create-home --shell /usr/sbin/nologin xmr-gateway
        fi

        install -d -m 0700 -o xmr-gateway -g xmr-gateway /var/lib/xmr-gateway
        install -d -m 0700 -o xmr-gateway -g xmr-gateway /var/lib/xmr-gateway/wallet
        install -d -m 0700 -o xmr-gateway -g xmr-gateway /var/lib/xmr-gateway/backups
        install -d -m 0750 -o root -g xmr-gateway /etc/xmr-gateway

        if [ -f /etc/xmr-gateway/env.example ]; then
            chown root:xmr-gateway /etc/xmr-gateway/env.example
            chmod 0640 /etc/xmr-gateway/env.example
        fi

        # Never overwrite an existing /etc/xmr-gateway/.env on upgrade!
        # Rewrite relative DATABASE_URL to the canonical /var/lib/xmr-gateway path so
        # xmr-gateway.service, monero-wallet-rpc.service, backup timer, and xmr-gateway-admin match.
        if [ ! -f /etc/xmr-gateway/.env ] && [ -f /etc/xmr-gateway/env.example ]; then
            tmp_env="$(mktemp /etc/xmr-gateway/.env.tmp.XXXXXX)"
            chmod 0600 "$tmp_env"
            sed 's|^DATABASE_URL=sqlite://data/xmr_gateway\.db$|DATABASE_URL=sqlite:///var/lib/xmr-gateway/xmr_gateway.db|' \
                /etc/xmr-gateway/env.example > "$tmp_env"
            install -m 0600 -o xmr-gateway -g xmr-gateway "$tmp_env" /etc/xmr-gateway/.env
            rm -f "$tmp_env"
            if command -v restorecon >/dev/null 2>&1; then
                restorecon /etc/xmr-gateway/.env 2>/dev/null || true
            fi
        fi

        if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
            systemctl daemon-reload || true
        fi

        cat <<'EOF'
==============================================================================
xmr-gateway installed! Services are NOT auto-started until secrets are set.
Next steps:
  1. Generate strong secrets:
       sudo xmr-gateway-admin --env /etc/xmr-gateway/.env config rotate-keys all
  2. Edit /etc/xmr-gateway/.env (WALLET_MODE, MONERO_NETWORK, MONERO_VIEW_ONLY_ADDRESS/KEY;
     MONERO_REMOTE_NODE auto-selects per network if left empty).
  3. Install SHA256-verified monero-wallet-rpc into /usr/local/bin/:
       sudo xmr-gateway-admin service setup-rpc
  4. Initialize the wallet and 0600 gateway_wallet.password in /var/lib/xmr-gateway/wallet/:
       sudo xmr-gateway-admin --env /etc/xmr-gateway/.env wallet create-view-only
       # or for hot_wallet mode:
       sudo xmr-gateway-admin --env /etc/xmr-gateway/.env wallet create-hot
  5. Verify configuration:
       sudo xmr-gateway-admin --env /etc/xmr-gateway/.env config doctor
  6. Enable and start services:
       sudo systemctl enable --now monero-wallet-rpc.service xmr-gateway.service
       sudo systemctl enable --now xmr-gateway-backup.timer   # optional daily hot backup
==============================================================================
EOF
        ;;
esac

exit 0
