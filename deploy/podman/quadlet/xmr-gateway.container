# ==============================================================================
# Rootless Podman Quadlet — xmr-gateway Container
# ==============================================================================
# Install to: ~/.config/containers/systemd/xmr-gateway.container
# Also copy: xmr-gateway-internal.network, xmr-gateway-egress.network, monero-wallet-rpc.container
# Prerequisites:
#   mkdir -p ~/.local/share/xmr-gateway/data ~/.local/share/xmr-gateway/wallet ~/.config/xmr-gateway
#   chmod 700 ~/.local/share/xmr-gateway ~/.local/share/xmr-gateway/data ~/.local/share/xmr-gateway/wallet ~/.config/xmr-gateway
#   podman build -t localhost/xmr-gateway:latest -f Containerfile .
#   # Quadlet units are generated dynamically (do NOT use `systemctl --user enable`):
#   systemctl --user daemon-reload && systemctl --user start monero-wallet-rpc xmr-gateway
#   loginctl enable-linger "$USER"
# ==============================================================================

[Unit]
Description=xmr-gateway Payment Gateway Container (rootless Podman Quadlet)
After=network-online.target monero-wallet-rpc.service
Wants=network-online.target monero-wallet-rpc.service

[Container]
Image=localhost/xmr-gateway:latest
ContainerName=xmr-gateway
EnvironmentFile=%h/.config/xmr-gateway/gateway.env
Environment=HOST=0.0.0.0
Environment=PORT=8080
Environment=DATABASE_URL=sqlite:///data/xmr_gateway.db
Environment=MONERO_RPC_URL=http://xmr-gateway-wallet-rpc:18082/json_rpc

# Bind strictly to host loopback; expose externally only behind Caddy/Nginx TLS
PublishPort=127.0.0.1:8080:8080

# Map host user UID directly to container UID 10001 (0600/0700 DB & WAL permissions preserved)
UserNS=keep-id:uid=10001,gid=10001

# Isolated gateway data dir ONLY (sibling of wallet/ — never mounts wallet keys & avoids :Z conflict)
Volume=%h/.local/share/xmr-gateway/data:/data:Z
Tmpfs=/tmp:rw,noexec,nosuid,size=64m

# Attach to isolated internal RPC bridge + egress bridge (avoids Podman 5 pasta/bridge conflict)
Network=xmr-gateway-internal.network
Network=xmr-gateway-egress.network

# Native Podman OCI healthcheck (anonymous /health probe, zero secrets)
HealthCmd=curl -fsS http://127.0.0.1:8080/health | grep -q '"status":"ok"'
HealthInterval=30s
HealthTimeout=5s
HealthStartPeriod=10s
HealthRetries=3

StopSignal=SIGTERM
StopTimeout=30

ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
SecurityLabelDisable=false

[Service]
Restart=on-failure
RestartSec=5
TimeoutStopSec=40

[Install]
WantedBy=default.target
