# ==============================================================================
# Rootless Podman Quadlet — monero-wallet-rpc Sidecar Container
# ==============================================================================
# Install to: ~/.config/containers/systemd/monero-wallet-rpc.container
# Also copy: xmr-gateway-internal.network, xmr-gateway-egress.network, xmr-gateway.container
# Prerequisites:
#   mkdir -p ~/.local/share/xmr-gateway/data ~/.local/share/xmr-gateway/wallet ~/.config/xmr-gateway
#   chmod 700 ~/.local/share/xmr-gateway ~/.local/share/xmr-gateway/data ~/.local/share/xmr-gateway/wallet ~/.config/xmr-gateway
#   # Put 0600 env file at ~/.config/xmr-gateway/gateway.env and initialize wallet in ~/.local/share/xmr-gateway/wallet/
#   # Pull prebuilt GHCR image (or build locally with `podman build -t localhost/xmr-gateway-wallet-rpc:latest -f deploy/docker/Containerfile.monero-rpc .`
#   # and switch Image= below to `localhost/xmr-gateway-wallet-rpc:latest`):
#   podman pull ghcr.io/xeonit-dev/xmr-gateway-wallet-rpc:v0.1.5
#   # Quadlet units are generated dynamically (do NOT use `systemctl --user enable`):
#   systemctl --user daemon-reload && systemctl --user start monero-wallet-rpc xmr-gateway
#   loginctl enable-linger "$USER"
# ==============================================================================

[Unit]
Description=Monero Wallet JSON-RPC Container (rootless Podman Quadlet)
After=network-online.target
Wants=network-online.target

[Container]
# Prebuilt multi-arch GHCR image (change to `localhost/xmr-gateway-wallet-rpc:latest` for local builds)
Image=ghcr.io/xeonit-dev/xmr-gateway-wallet-rpc:v0.1.5
ContainerName=xmr-gateway-wallet-rpc
EnvironmentFile=%h/.config/xmr-gateway/gateway.env

# Map host user UID directly to container UID 10001 so 0600/0700 host files remain readable
UserNS=keep-id:uid=10001,gid=10001

# Private SELinux relabel (:Z) on isolated wallet dir only; zero host ports published
Volume=%h/.local/share/xmr-gateway/wallet:/wallet:Z
Tmpfs=/tmp:rw,noexec,nosuid,size=64m

# Attach to isolated internal RPC bridge + egress bridge (avoids Podman 5 pasta/bridge conflict)
Network=xmr-gateway-internal.network
Network=xmr-gateway-egress.network

StopSignal=SIGTERM
StopTimeout=30

ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
SecurityLabelDisable=false

[Service]
Restart=on-failure
RestartSec=5
TimeoutStopSec=40

[Install]
WantedBy=default.target
