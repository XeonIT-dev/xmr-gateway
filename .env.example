# ==============================================================================
# xmr-gateway Configuration
# ==============================================================================
# Copy this file to .env and replace all placeholder secrets before running.
# NEVER commit your real .env file to version control.
# Note: ./start.sh automatically generates 32-byte random secrets via OpenSSL
# if API_SECRET_KEY, WEBHOOK_SECRET, or MONERO_RPC_PASS still hold placeholders.

# ------------------------------------------------------------------------------
# HTTP Server
# ------------------------------------------------------------------------------
# Bind interface (keep 127.0.0.1 when running behind Caddy/Nginx TLS reverse proxy)
HOST=127.0.0.1
# TCP listening port for the REST API
PORT=8080
# Comma-separated CORS allowlist (leave empty to disable cross-origin browser access)
CORS_ALLOWED_ORIGINS=

# ------------------------------------------------------------------------------
# SQLite Persistence (WAL Mode)
# ------------------------------------------------------------------------------
# SQLite connection string. Parent directory is created automatically.
DATABASE_URL=sqlite://data/xmr_gateway.db

# ------------------------------------------------------------------------------
# Cryptographic Authentication & Webhook Signing
# ------------------------------------------------------------------------------
# Required >= 32-byte secret checked in constant time against the X-API-Key header.
# Generate manually: openssl rand -hex 32
API_SECRET_KEY=replace-with-at-least-32-bytes-of-high-entropy-random-hex

# Privileged >= 32-byte operator secret (must differ from API_SECRET_KEY) isolating
# /sweep, /sweep/resolve, /webhooks/{id}/retry, and /invoices/{id}/webhooks/retry from
# the merchant API_SECRET_KEY (RBAC separation of duties, AUDIT-002 / XMR-AUDIT-004).
# REQUIRED when WALLET_MODE=hot_wallet or ENABLE_AUTO_SWEEP=true.
# In WALLET_MODE=view_only, may be cleared (`OPERATOR_API_KEY=`) for single-tenant fallback.
OPERATOR_API_KEY=replace-with-distinct-at-least-32-bytes-operator-secret

# Required >= 32-byte secret used to compute HMAC-SHA256 signatures (X-Signature-256).
# Generate manually: openssl rand -hex 32
WEBHOOK_SECRET=replace-with-at-least-32-bytes-of-webhook-hmac-secret

# Optional fallback webhook URL used when POST /api/v1/invoices omits callback_url.
# Leave empty or use public HTTPS URL in production; for local loopback testing (127.0.0.1:9000),
# set ALLOW_PRIVATE_WEBHOOKS=true below.
DEFAULT_WEBHOOK_URL=

# Outbound Webhook SSRF Policy (XMR-001)
# Production default false blocks loopback (127.0.0.0/8, ::1), RFC1918 private subnets,
# link-local/metadata IPs (169.254.169.254), and DNS-rebound private answers.
# Set ALLOW_PRIVATE_WEBHOOKS=true ONLY for local loopback testing (e.g., demo-stagenet.sh).
ALLOW_PRIVATE_WEBHOOKS=false
# Require https:// for outbound webhook URLs.
# On mainnet with ALLOW_PRIVATE_WEBHOOKS=false, public HTTP webhooks are FORBIDDEN (fail-closed at
# startup) and omitting this variable defaults to true. Cleartext http:// is allowed only on
# stagenet/testnet or when ALLOW_PRIVATE_WEBHOOKS=true (e.g., local loopback bot on 127.0.0.1).
REQUIRE_HTTPS_WEBHOOKS=true

# ------------------------------------------------------------------------------
# Monero Wallet RPC & Remote Daemon Settings
# ------------------------------------------------------------------------------
# Target Monero network for start.sh: "mainnet" or "stagenet"
MONERO_NETWORK=mainnet

# Local monero-wallet-rpc JSON-RPC 2.0 endpoint
MONERO_RPC_URL=http://127.0.0.1:18082/json_rpc

# Optional monerod JSON-RPC endpoint required for fail-closed height synchronization checks
# (`monero-wallet-rpc` `get_height` vs `monerod` `get_info`) during POST /api/v1/invoices/{id}/sweep/resolve
# with action=allow_resweep (XMR-043 / AUDIT-001). monero-wallet-rpc v0.18 does not expose daemon sync RPC.
# Must satisfy RPC transport security policy (https:// or loopback, or ALLOW_INSECURE_REMOTE_RPC=true).
# MONERO_DAEMON_RPC_URL=http://127.0.0.1:18081/json_rpc
# Optional Digest/Basic credentials for MONERO_DAEMON_RPC_URL (both must be set together if used;
# required when ALLOW_UNAUTHENTICATED_RPC=false and MONERO_DAEMON_RPC_URL is configured).
# MONERO_DAEMON_RPC_USER=monerod_rpc_user
# MONERO_DAEMON_RPC_PASS=replace-with-secure-daemon-rpc-password

# Required HTTP Digest/Basic credentials written to a 0600 --config-file for monero-wallet-rpc
# (never passed in process argv; XMR-AUDIT-005).
MONERO_RPC_USER=xmr_gateway_user
MONERO_RPC_PASS=replace-with-secure-rpc-password

# Fail-closed RPC security overrides (keep false in production)
# ALLOW_UNAUTHENTICATED_RPC=true permits missing MONERO_RPC_USER/PASS (testing only).
ALLOW_UNAUTHENTICATED_RPC=false
# ALLOW_INSECURE_REMOTE_RPC=true permits cleartext http:// to non-loopback MONERO_RPC_URL hosts.
ALLOW_INSECURE_REMOTE_RPC=false

# Pinned Monero CLI release verification settings for ./start.sh --setup-rpc
MONERO_CLI_VERSION=v0.18.5.4
MONERO_CLI_SHA256=ba2928962c101b609434bf8c1b43ad59ebe96c5525977284ca599d8bf0f02d10

# Remote Monero node (host:port) used by start.sh / systemd / admin CLI (zero local blockchain bloat).
# Leave empty to auto-select a network-appropriate default:
#   mainnet  -> xmr-node.cakewallet.com:18081
#   stagenet -> node.monerodevs.org:38089
#   testnet  -> testnet.xmr-tw.org:28081
MONERO_REMOTE_NODE=

# Set true ONLY when connecting to your own trusted monerod daemon; otherwise start.sh
# passes --untrusted-daemon so wallet heuristics are protected (XMR-005).
MONERO_TRUSTED_DAEMON=false

# Initial blockchain height when creating a new wallet (avoids scanning from block 0).
# Leave empty to query the live chain tip from MONERO_REMOTE_NODE and use max(0, height - 1000)
# (safe offline fallbacks: mainnet=3500000, stagenet=2000000, testnet=2900000).
WALLET_RESTORE_HEIGHT=

# Optional SOCKS5 proxy for monero-wallet-rpc (e.g., 127.0.0.1:9050 for Tor routing)
MONERO_RPC_PROXY=

# Explicit wallet custody mode (XMR-002): "view_only" (fail-closed) or "hot_wallet"
# Defaults to "view_only" when ENABLE_AUTO_SWEEP=false, or "hot_wallet" when ENABLE_AUTO_SWEEP=true.
WALLET_MODE=view_only

# Required on first run when WALLET_MODE=view_only (start.sh refuses to silently create a hot wallet)
# MONERO_VIEW_ONLY_ADDRESS=
# MONERO_VIEW_ONLY_KEY=

# Explicit safety override if running WALLET_MODE=hot_wallet with ENABLE_AUTO_SWEEP=false
ALLOW_HOT_WALLET_WITHOUT_SWEEP=false

# ------------------------------------------------------------------------------
# Custody Mode & Auto-Sweep Engine
# ------------------------------------------------------------------------------
# false = View-Only Zero-Trust Mode (server holds view key only; no private spend key)
# true  = Hot Auto-Sweep Mode (requires WALLET_MODE=hot_wallet; sweeps >= 10 blocks to COLD_WALLET_ADDRESS)
ENABLE_AUTO_SWEEP=false

# Destination Monero address for automated and manual sweeps (REQUIRED if ENABLE_AUTO_SWEEP=true)
COLD_WALLET_ADDRESS=

# Monero transaction fee priority for sweep_all (0=default, 1=unimportant, 2=normal, 3=elevated, 4=priority)
SWEEP_PRIORITY=0

# ------------------------------------------------------------------------------
# Confirmations, Reorg Finality, Expiration & Monitoring (XMR-004 / XMR-006)
# ------------------------------------------------------------------------------
# Minimum block confirmations required to mark an invoice CONFIRMED (>= 1; default 10)
REQUIRED_CONFIRMATIONS=10

# Block confirmations required for full Monero unlocked settlement finality (SETTLED;
# requires unlocked covering outputs >= invoice amount at >= SETTLEMENT_CONFIRMATIONS; XMR-AUDIT-001)
SETTLEMENT_CONFIRMATIONS=10

# Retention window in days for scanning terminal subaddresses (0 = continuous/unbounded monitoring
# across all non-archived subaddresses so late payments after any delay are always detected)
SUBADDRESS_MONITOR_DAYS=0

# Default invoice time-to-live in seconds (3600 = 1 hour)
INVOICE_TTL_SECONDS=3600

# Background blockchain/mempool scanner interval in seconds
SCAN_INTERVAL_SECONDS=10

# Maximum subaddress indices queried per monero-wallet-rpc get_transfers batch (1..=1000; default 100)
# Prevents exceeding the 16 MiB RPC response limit as monitored invoice count grows.
SCANNER_SUBADDRESS_BATCH_SIZE=100

# Background webhook retry dispatcher interval in seconds
WEBHOOK_POLL_INTERVAL_SECONDS=5

# ------------------------------------------------------------------------------
# Observability
# ------------------------------------------------------------------------------
# Tracing filter directives (e.g., info,xmr_gateway=debug,sqlx=warn)
RUST_LOG=info,xmr_gateway=debug
# Log output format: "json" (structured production logs) or "pretty" (human-readable local dev)
LOG_FORMAT=json
